# Copy to .env and fill in your own web login / 复制为 .env，填写自己的网页登录信息
HOST=127.0.0.1
PORT=26903
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

AGY_BIN=agy
AGY_TIMEOUT=1800
AGY_SANDBOX=0
AGY_OUTPUT_FORMAT=stream-json
AGY_PERSIST_CONVERSATIONS=true

# desktop: tested desktop client profile; native: original CLI profile
# desktop：已验证的桌面客户端配置；native：原生 CLI 配置
AGY_UPSTREAM_PROFILE=desktop
AGY_DESKTOP_VERSION=2.22.0

# Only these folders are available in the web folder picker/download API.
# 网页文件夹选择与下载接口可访问的目录；Linux 多个目录用冒号分隔。
AGY_ALLOWED_ROOTS=./scratch
AGY_SCRATCH=./scratch
AGY_UPLOADS=./uploads
AGY_MESSAGES_DIR=./data/messages
AGY_CONVERSATIONS_FILE=./.antigravity_conversations.json

AGY_DISABLE_MCP=false
AGY_DISABLED_MCP_SERVERS=
# AGY_RUNTIME_HOME=./scratch/.agy-home
